include <stdio.h>

int main() {
    int x;
    scanf ("%d", &x);
    for (int i = 1; i <= x; i++) {
        if (i == 1 || i == x) {
            for (int j = 1; j <= x; j++) {
                printf ("*");
            }
        } else {
            for (int k = 1; k <= x; k++) {
                if (k == 1 || k == x) {
                    printf ("*");
                } else {
                    printf (" ");
                }
            }
        }
        printf ("\n");
    }

    return 0;
}
