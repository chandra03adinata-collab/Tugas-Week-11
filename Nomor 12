#include <stdio.h>

int main() {
    int x;
    printf ("Height: ");
    scanf ("%d", &x);
    for (int i = 1; i <= x; i++) {
        for (int j = 1; j <= x - i; j++) {
            printf (" ");
        }
        for (int k = 1; k <= i * 2 - 1; k++) {
            printf ("*");
        }
        printf ("\n");
    }
    return 0;
}
