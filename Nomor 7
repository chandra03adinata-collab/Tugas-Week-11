#include <stdio.h>

int main() {
    int min, max, a;
    a = 0;
    scanf("%d  %d", &min, &max);
    for (min; min <= max; min++) {
        for (int i = 2; i <= min; i++) {
            if (min % i == 0) {
                a = a + 1;
            }
            
        }
        if (a == 1) {
                printf ("%d ", min);
        }
        a = 0;
    }
    return 0;
}
